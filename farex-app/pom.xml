<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.farex</groupId>
        <artifactId>farex-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.farex</groupId>
    <artifactId>farex-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>farex-app</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>16</javafx.version>
        <glisten.version>6.0.5</glisten.version>
        <attach.version>4.0.22</attach.version>
        <mainClassName>com.farex.ui.UiLauncher</mainClassName>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.farex</groupId>
            <artifactId>farex-shared</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- WebView for the OpenStreetMap / Leaflet map (com.farex.ui.common.LeafletMap) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq</groupId>
            <artifactId>charm-glisten</artifactId>
            <version>${glisten.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>display</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>lifecycle</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>statusbar</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>storage</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>util</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <!-- phone keyboard height, to keep the field being typed in above it -->
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>keyboard</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <!-- opens the PayMongo checkout in the phone's browser -->
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>browser</artifactId>
            <version>${attach.version}</version>
        </dependency>
        <dependency>
            <!-- phone GPS for trip tracking (ui/trip/LocationSource) -->
            <groupId>com.gluonhq.attach</groupId>
            <artifactId>position</artifactId>
            <version>${attach.version}</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>Gluon</id>
            <url>https://nexus.gluonhq.com/nexus/content/repositories/releases</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.6</version>
                <configuration>
                    <mainClass>${mainClassName}</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>1.0.29</version>
                <configuration>
                    <!-- Uncomment to run on iOS: -->
                    <!-- <target>ios</target>-->
                    <attachList>
                        <list>display</list>
                        <list>lifecycle</list>
                        <list>statusbar</list>
                        <list>storage</list>
                        <list>position</list>   <!-- phone GPS for trip tracking -->
                        <list>keyboard</list>
                        <list>browser</list>
                    </attachList>
                    <appIdentifier>com.farex.app</appIdentifier>
                    <resourcesList>
                        <list>.*[.]ttf$</list>     <!-- the bundled Inter font -->
                    </resourcesList>
                    <releaseConfiguration>
                        <appLabel>FareX</appLabel>
                        <versionCode>1</versionCode>
                        <versionName>1.0</versionName>
                    </releaseConfiguration>
                    <reflectionList>
                        <list>com.gluonhq.impl.charm.glisten.control.skin.GlistenButtonSkin</list>
                        <!-- JavaFX finds the Application class by name at start; without this the native app shows a black screen -->
                        <list>com.farex.ui.FarexApp</list>
                        <!-- JavaFX looks these up by name the first time one is drawn (missing one = crash on that screen) -->
                        <list>javafx.scene.shape.Arc</list>
                        <list>javafx.scene.shape.Circle</list>
                        <list>javafx.scene.shape.CubicCurve</list>
                        <list>javafx.scene.shape.Line</list>
                        <list>javafx.scene.shape.Path</list>
                        <list>javafx.scene.shape.Polygon</list>
                        <list>javafx.scene.shape.Polyline</list>
                        <list>javafx.scene.shape.Rectangle</list>
                        <list>javafx.scene.shape.Shape</list>
                        <list>javafx.scene.canvas.Canvas</list>
                        <list>javafx.scene.image.ImageView</list>
                        <list>javafx.scene.text.Text</list>
                        <list>javafx.scene.text.TextFlow</list>
                        <list>javafx.scene.Group</list>
                        <list>javafx.scene.control.ProgressIndicator</list>
                        <list>javafx.scene.control.ScrollPane</list>
                        <list>javafx.scene.control.PasswordField</list>
                        <list>javafx.scene.layout.GridPane</list>
                        <list>javafx.scene.layout.BorderPane</list>
                    </reflectionList>
                    <mainClass>${mainClassName}</mainClass>
                </configuration>
            </plugin>
        </plugins>

    </build>

    <pluginRepositories>
        <pluginRepository>
            <id>gluon-releases</id>
            <url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
